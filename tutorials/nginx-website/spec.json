{
 "id": "nginx-website",
 "title": "Host Your Own Website on Linux",
 "subtitle": "nginx in about a minute",
 "summary": "Install nginx, start it, open localhost in the browser, publish your own page and verify it answers 200 OK.",
 "match": [
  "nginx",
  "engine-x",
  "web server",
  "webserver",
  "host a website",
  "host website",
  "host my website",
  "website on linux",
  "self host"
 ],
 "software": "nginx",
 "tags": [
  "nginx",
  "linux",
  "web server",
  "self hosting",
  "ubuntu",
  "debian",
  "apt",
  "curl",
  "beginner",
  "tutorial"
 ],
 "steps": [
  {
   "id": "install",
   "label": "Install nginx",
   "narration": [
    "install",
    "installed"
   ],
   "action": {
    "kind": "terminal",
    "command": "apt-get install -y nginx",
    "timeout": 300,
    "clear": true
   },
   "badge": "nginx installed",
   "zoom_out_after": true,
   "highlight": {
    "command": "apt-get install"
   }
  },
  {
   "id": "start",
   "label": "Start the server",
   "narration": [
    "start"
   ],
   "action": {
    "kind": "terminal",
    "command": "nginx -v && nginx && echo 'nginx is running'",
    "clear": true,
    "ask": false
   },
   "badge": "Server running",
   "success": true,
   "highlight": {
    "command": "check version, then start",
    "output": {
     "lines": 2,
     "chars": 28,
     "label": "It's running"
    }
   }
  },
  {
   "id": "browser",
   "label": "Open localhost",
   "narration": [
    "browser"
   ],
   "action": {
    "kind": "open_url",
    "url": "localhost",
    "app": "browser"
   },
   "badge": "Welcome page served",
   "focus": {
    "zoom": 1.7,
    "cx": 900,
    "cy": 330
   },
   "highlight": {
    "box": {
     "x": 520,
     "y": 160,
     "w": 470,
     "h": 64,
     "label": "Served by nginx"
    }
   }
  },
  {
   "id": "write",
   "label": "Publish your page",
   "narration": [
    "write"
   ],
   "action": {
    "kind": "terminal",
    "clear": true,
    "ask": false,
    "command": "echo '<body style=\"margin:0;height:100vh;display:grid;place-items:center;background:linear-gradient(135deg,#0f172a,#4f46e5);color:#fff;font-family:sans-serif\"><h1 style=\"font-size:6vw\">Hello from my Linux server &#128640;</h1></body>' > /var/www/html/index.html"
   },
   "badge": "index.html written",
   "zoom": 1.0,
   "highlight": {
    "command": "one line of HTML"
   }
  },
  {
   "id": "reload",
   "label": "Reload the page",
   "narration": [
    "reload"
   ],
   "action": {
    "kind": "key",
    "keys": "F5",
    "app": "browser"
   },
   "badge": "Your page is live",
   "success": true,
   "focus": {
    "zoom": 1.25,
    "cx": 960,
    "cy": 640
   },
   "highlight": {
    "box": {
     "x": 120,
     "y": 540,
     "w": 1680,
     "h": 130,
     "label": "Your page"
    }
   }
  },
  {
   "id": "verify",
   "label": "Verify with curl",
   "narration": [
    "verify"
   ],
   "action": {
    "kind": "terminal",
    "command": "curl -sI localhost | head -n 1",
    "clear": true,
    "ask": false
   },
   "badge": "HTTP 200 OK",
   "success": true,
   "highlight": {
    "command": "ask the server",
    "output": {
     "lines": 1,
     "chars": 15,
     "label": "200 OK"
    }
   }
  }
 ]
}

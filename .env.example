# Where the SQLite DB, uploads and job artifacts live (default ./data)
CUEFRAME_DATA_DIR=data
CUEFRAME_MAX_UPLOAD_MB=500
CUEFRAME_MAX_CONCURRENT_JOBS=2
# Placeholder demo job: total runtime in seconds, and whether it renders a clip with ffmpeg
CUEFRAME_DEMO_JOB_SECONDS=12
CUEFRAME_DEMO_RENDER_VIDEO=1
# Dashboard login wall (single default user, upserted on startup). Change these!
CUEFRAME_ADMIN_USERNAME=admin
CUEFRAME_ADMIN_PASSWORD=cueframe
# Set to 1 behind HTTPS so the session cookie is Secure
CUEFRAME_COOKIE_SECURE=0

# Meta Model API (docs research agent)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
CUEFRAME_RESEARCH_MODEL=muse-spark-1.3-contributor
CUEFRAME_RESEARCH_CONFIDENCE=0.7
CUEFRAME_RESEARCH_MAX_PAGES=4
CUEFRAME_RESEARCH_MAX_ROUNDS=2
CUEFRAME_LOG_LEVEL=INFO

# Plans, usage and growth (see docs/usage-and-plans.md and docs/guard-share-monitoring.md)
CUEFRAME_DEFAULT_PLAN=free
CUEFRAME_ADMIN_PLAN=unlimited
CUEFRAME_PLAN_LIMITS=
CUEFRAME_LOG_RETENTION_DAYS=30
CUEFRAME_PUBLIC_URL=http://localhost:8000
CUEFRAME_OPEN_SIGNUP=1
CUEFRAME_TURNSTILE_SITE_KEY=
CUEFRAME_TURNSTILE_SECRET=
CUEFRAME_RATE_LOGIN_PER_MIN=10
CUEFRAME_RATE_SIGNUP_PER_HOUR=5
CUEFRAME_RATE_MESSAGES_PER_MIN=20
CUEFRAME_DAILY_SPEND_CAP_USD=25
CUEFRAME_VIDEO_COSTS=
CUEFRAME_ALERT_WEBHOOK=
SENTRY_DSN=
CUEFRAME_WATERMARK_PLANS=free
CUEFRAME_REFERRAL_BONUS=3
# Optional per-language voices, e.g. ELEVENLABS_VOICE_ID_HI
